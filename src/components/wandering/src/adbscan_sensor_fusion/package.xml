<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adbscan_sensor_fusion</name>
  <version>0.1.0</version>
  <description>
    Fuses a 2D LiDAR (sensor_msgs/LaserScan) and a depth camera point cloud
    (sensor_msgs/PointCloud2) into a single 3D point cloud expressed in a common
    robot frame. The 2D scan is lifted into 3D at its real mount height so that
    the downstream ADBSCAN clustering keeps 360-degree coverage while gaining the
    camera's height-aware detection of small-projection obstacles.
  </description>
  <maintainer email="eci-maintainer@intel.com">ECI Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>laser_geometry</depend>
  <depend>message_filters</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <build_depend>libpcl-dev</build_depend>
  <build_export_depend>libpcl-dev</build_export_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
