<package format="3">
  <name>wandering_app</name>
  <version>2.4.0</version>
  <description>Wandering application</description>
  <maintainer email="eci-maintainer@intel.com">ECI Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_msgs</depend>
  <depend>nav2_util</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp_action</depend>
  <depend>action_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>ament_index_cpp</depend>
  <depend>pluginlib</depend>
  <depend>rviz_common</depend>
  <depend>tf2_ros</depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>


  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz_common plugin="${prefix}/wandering_rviz_plugins.xml" />
  </export>
</package>
