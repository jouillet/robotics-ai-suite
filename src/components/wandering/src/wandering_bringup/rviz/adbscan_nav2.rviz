Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Name: J100 Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /j100_0812/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: RealSense Color Image
      Enabled: true
      Topic:
        Value: /j100_0812/sensors/camera_0/color/image
        Reliability Policy: Best Effort
      Transport Hint: raw
    - Class: rviz_default_plugins/LaserScan
      Name: Navigation Scan
      Enabled: true
      Size (m): 0.03
      Color: 255; 255; 0
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: ADBScan Input (Fused Cloud)
      Enabled: true
      Size (m): 0.02
      Style: Points
      Color: 0; 200; 255
      Topic:
        Value: /adbscan/points
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/MarkerArray
      Name: ADBScan Obstacles
      Enabled: true
      Topic:
        Value: /adbscan/obstacle_markers
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Enabled: true
      Alpha: 0.35
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Color: 0; 255; 0
      Topic:
        Value: /plan
        Reliability Policy: Reliable
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.0
      Target Frame: base_link
      Yaw: 3.14
Window Geometry:
  Height: 900
  Width: 700
  X: 0
  Y: 0
